graph TB
  LEG_A["Legend: Active"]
  LEG_I["Legend: Implemented"]
  LEG_P["Legend: Planned"]

  subgraph "Feature Modules (Active and Implemented Core)"
    RH["Runtime Hierarchy (V01)<br/>Campaign -> Scene -> Combat lifecycle"]
    AX["Action Execution and Turn Economy (V02)<br/>Operation graph, targeting, budgets, effects"]
    CW["Content Write Path (V05)<br/>Definition CRUD, lifecycle transitions, link integrity"]
    CR["Content Query and Projection (V05)<br/>Search, detail hydration, revision-aware reads"]
    CP["Campaign Scope and Membership (V05 extension)<br/>Membership, role policy, content policy"]
    CH["Character Sheet Domain (V05 extension)<br/>Progression, inventory, prepared spells, hydration"]
    IE["Identity and Entitlements (V05 extension)<br/>Accounts, subscriptions, pack access"]
    AM["Asset Management (V05 extension)<br/>Asset records, folders, media references"]
    API["Transport Interfaces<br/>REST routers and WebSocket handlers"]
    AUD["Audit and Recovery<br/>Checkpoints, drift detection, replay"]
  end

  subgraph "Horizontal Contracts (Layer 1)"
    HC_LIF["Lifecycle and Revision Contract"]
    HC_REF["Referential Integrity Contract"]
    HC_ACT["Action Operation Graph Contract"]
    HC_EVT["Event Ordering and Correlation Contract"]
    HC_PROJ["Projection Consistency Contract"]
    HC_AUTH["Authorization and Visibility Contract"]
  end

  subgraph "Infrastructure"
    INF_DB["PostgreSQL Source of Truth"]
    INF_IDX["Search Projection Store"]
    INF_BUS["Event Stream / Message Bus"]
    INF_BLOB["Asset Blob Storage"]
    INF_OBS["Monitoring and Telemetry"]
  end

  subgraph "Planned Extensions (Separate Scope)"
    PX_WC["V03 World Context Runtime<br/>Region, Place, Faction, NPC"]
    PX_SCHEMA["V04 Content Schema and Pack Lifecycle<br/>Compatibility, provenance, supersedence"]
    PX_EVT["V06 Event Contract Freeze and Frontend Projection"]
  end

  IE --> CP
