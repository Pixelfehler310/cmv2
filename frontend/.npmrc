# Primary path in Docker dev is the local link bind mount from the sibling civic repo.
# Optional fallback only: route @civic scope to local registry when explicitly needed.
@civic:registry=http://localhost:4873
# Da wir lokal sind, erlauben wir anonymen Zugriff (oder jeglichen Token)
//localhost:4873/:_authToken="anonymous"
# Optional: Verhindert, dass pnpm/npm versucht, @civic auf dem echten npmjs.org zu suchen
always-auth=false
