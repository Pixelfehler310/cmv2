%% ---------------------------------------------------------------------------
%% Key relations
%% ---------------------------------------------------------------------------
Campaign --> SceneState : contains [1..*]
SceneState --> EncounterState : optional active_encounter [0..1]
Campaign --> RegionState : owns [0..*]
RegionState --> PlaceState : owns [0..*]
PlaceState --> SceneState : contextualizes [0..*]
Campaign --> FactionState : owns [0..*]
FactionState --> PlaceState : influences [0..*]
Campaign --> NpcState : owns [0..*]
NpcState --> PlaceState : located_in [0..1]
NpcState --> FactionState : affiliated_with [0..1]
EncounterState --> ActorInstance : owns [0..*]
EncounterState --> TurnBudget : owns [0..*]
EncounterState --> EffectInstanceRuntime : owns [0..*]
SceneState --> MapState : owns
MapState --> MapToken : owns [0..*]
MapToken --> ActorInstance : references actor_id
ActorInstance --> EffectInstanceRuntime : owns [0..*]

ActionDefinitionContent --> EffectDefinitionContent : references via effect_intents
AbilityBindingContent --> ActionDefinitionContent : binds action_id
ContentPackMetadata --> ActionDefinitionContent : owns [0..*]
ContentPackMetadata --> EffectDefinitionContent : owns [0..*]
ContentPackMetadata --> AbilityBindingContent : owns [0..*]

ActionExecutionApplicationService --> SceneRepository : queries
ActionExecutionApplicationService --> EncounterRepository : reads/writes
ActionExecutionApplicationService --> CombatLogRepository : logs
ActionExecutionApplicationService --> AuthorizationPolicy : validates
ActionExecutionApplicationService --> ActionEconomyPolicy : budgets
ActionExecutionApplicationService --> ActionResolutionPolicy : resolves

ContentPackApplicationService --> ContentRepository : CRUD
ContentRepository --> ActionDefinitionRecord : persists
ContentRepository --> EffectDefinitionRecord : persists

CompendiumApplicationService --> CompendiumRepository : CRUD
CompendiumRepository --> ItemDefinitionRecord : persists
CompendiumRepository --> MonsterDefinitionRecord : persists
CompendiumRepository --> SpellDefinitionRecord : persists
CompendiumRepository --> FeatureDefinitionRecord : persists
CompendiumRepository --> FeatDefinitionRecord : persists

WorldContextApplicationService --> WorldContextRepository : CRUD
WorldContextRepository --> RegionRecord : persists
WorldContextRepository --> PlaceRecord : persists
WorldContextRepository --> NpcRecord : persists
WorldContextRepository --> FactionRecord : persists

SceneRepository --> SceneRecord : persists
EncounterRepository --> EncounterSessionRecord : persists
EncounterRepository --> CombatantStateRecord : persists
EncounterRepository --> TurnBudgetRecord : persists

CampaignRecord --> SceneRecord : contains [1..*]
CampaignRecord --> RegionRecord : contains [0..*]
CampaignRecord --> PlaceRecord : contains [0..*]
CampaignRecord --> NpcRecord : contains [0..*]
CampaignRecord --> FactionRecord : contains [0..*]
RegionRecord --> PlaceRecord : contains [0..*]
PlaceRecord --> SceneRecord : contextualizes [0..*]
PlaceRecord --> NpcRecord : hosts [0..*]
FactionRecord --> NpcRecord : includes [0..*]
SceneRecord --> EncounterSessionRecord : optional combat specialization [0..1]
CampaignRecord --> CampaignMemberRecord : owns [0..*]
CampaignMemberRecord --> User : references user_id
