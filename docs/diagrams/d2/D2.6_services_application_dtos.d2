# D2.6 Service and Application DTO Interactions
# Sources:
# - backend/src/systems/dnd5e/application/action_execution_service.py
# - backend/src/systems/dnd5e/services/combat_service.py

vars: {
  schema_color: "#2E86AB"
  service_color: "#F4A261"
  domain_color: "#E76F51"
}

Application: {
  label: "Application Layer"

  ActionExecutionRequest: {
    shape: class
    style.stroke: ${schema_color}
    "actor_id: str"
    "action_type: str"
    "action_name: str"
    "target_ids: list[str]"
    "action_payload: dict[str, Any]"
    "request_id: str | None"
    "raw_payload: dict[str, Any]"
    "require_canonical_action_id: bool"
  }

  ActionExecutionResult: {
    shape: class
    style.stroke: ${schema_color}
    "events: list[dict[str, Any]]"
  }

  ActionExecutionApplicationService: {
    shape: class
    style.stroke: ${service_color}
    "_combat_service: CombatService"
    "+ execute(request, encounter, encounter_session, ctx)"
    "- _build_domain_request(request)"
    "- _build_domain_context(request, encounter)"
  }
}

Services: {
  label: "Service Orchestration"

  CombatService: {
    shape: class
    style.stroke: ${service_color}
    "+ execute_action(...)"
    "+ check_can_act(...)"
    "+ consume_budget(...)"
    "+ apply_movement(...)"
    "+ get_attack_preview(...)"
    "+ get_executable_actions_snapshot(...)"
    "+ handle_end_turn(...)"
    "+ handle_move_token(...)"
    "+ handle_start_combat(...)"
    "+ log_action_attempt(...)"
    "+ sync_effect_instance_records(...)"
    "+ resolve_effect_intents(...)"
  }
}

DomainDTOs: {
  label: "Domain Pipeline Contracts"

  ActionResolutionRequest: {
    shape: class
    style.stroke: ${domain_color}
    "actor_id: str"
    "action_id: str"
    "action_type_cost: str"
    "family: str"
    "targeting_mode: str"
    "target_ids: list[str]"
    "payload: dict[str, Any]"
  }

  ActionResolutionContext: {
    shape: class
    style.stroke: ${domain_color}
    "campaign_id: str"
    "request_id: str | None"
    "round_number: int"
    "active_actor_id: str | None"
  }

  ActionResolutionDenial: {
    shape: class
    style.stroke: ${domain_color}
    "reason_code: str"
    "message: str"
    "checks: dict[str, Any] | None"
  }

  ActionResolutionSuccess: {
    shape: class
    style.stroke: ${domain_color}
    "events: list[dict[str, Any]]"
    "checks: dict[str, Any] | None"
  }
}

ActionExecutionApplicationService -> ActionExecutionRequest: "accepts"
ActionExecutionApplicationService -> ActionExecutionResult: "returns"
ActionExecutionApplicationService -> ActionResolutionRequest: "maps to"
ActionExecutionApplicationService -> ActionResolutionContext: "maps to"
ActionExecutionApplicationService -> CombatService: "orchestrates"
CombatService -> ActionResolutionDenial: "produces on failure"
CombatService -> ActionResolutionSuccess: "produces on success"
