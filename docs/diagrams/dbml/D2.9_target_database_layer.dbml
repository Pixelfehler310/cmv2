Project cmv2_target_database_layer {
  database_type: "PostgreSQL"
  Note: '''
  Target DB layer aligned to D2.9 target corrected architecture.

  Focus:
  - Scene-first campaign context (campaign -> scene -> optional active encounter).
  - First-class world context entities (regions, places, factions, npcs).
  - CRUD-complete compendium/content definitions with lifecycle metadata.
  - Repository-friendly separation of generic and dnd5e-specific persistence.
  '''
}

Enum campaign_role {
  DM
  PLAYER
  OBSERVER
}

Enum content_lifecycle_status {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

Enum place_type {
  CITY
  TOWN
  VILLAGE
  DUNGEON
  WILDERNESS
  LANDMARK
}

Enum npc_disposition {
  ALLIED
  NEUTRAL
  HOSTILE
}

Table users {
  id varchar [pk, not null, note: "UUID string"]
  username varchar [not null, unique]
  hashed_password varchar
  is_active boolean [not null, default: true]
  is_superuser boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    username [name: "ix_users_username", unique]
  }
}

Table campaigns {
  id varchar [pk, not null, note: "UUID string"]
  name varchar [not null]
  description text
  dm_id varchar [note: "Optional convenience link to users.id"]
  current_scene_id varchar
  active_encounter_id varchar
  context_version integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    name [name: "ix_campaigns_name"]
    current_scene_id [name: "ix_campaigns_current_scene_id"]
    active_encounter_id [name: "ix_campaigns_active_encounter_id"]
  }
}

Table campaign_members {
  id varchar [pk, not null, note: "UUID string"]
  campaign_id varchar [not null]
  user_id varchar [not null]
  role campaign_role [not null, default: 'PLAYER']
  active_character_id varchar
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (campaign_id, user_id) [name: "uq_campaign_members_campaign_user", unique]
  }
}

Table scenes {
  id varchar [pk, not null, note: "UUID string"]
  campaign_id varchar [not null]
  name varchar [not null]
  scene_type varchar [not null, note: "STANDARD|ENCOUNTER|REST|NARRATIVE"]
  state_json json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    campaign_id [name: "ix_scenes_campaign_id"]
    (campaign_id, name) [name: "ix_scenes_campaign_name"]
  }
}

Table encounter_sessions {
  id varchar [pk, not null, note: "UUID string"]
  campaign_id varchar [not null]
  scene_id varchar [not null]
  phase varchar [not null]
  round_number integer [not null, default: 1]
  active_index integer [not null, default: 0]
  combat_state_json json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    campaign_id [name: "ix_encounter_sessions_campaign_id"]
    scene_id [name: "ix_encounter_sessions_scene_id"]
  }
}

Table combatant_states {
  id varchar [pk, not null, note: "UUID string"]
  encounter_session_id varchar [not null]
  actor_id varchar [not null]
  initiative_order integer [not null]
  actor_snapshot json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    encounter_session_id [name: "ix_combatant_states_encounter_session_id"]
  }
}

Table turn_budgets {
  id varchar [pk, not null, note: "UUID string"]
  encounter_session_id varchar [not null]
  combatant_id varchar [not null]
  round_number integer [not null]
  action_available boolean [not null, default: true]
  bonus_action_available boolean [not null, default: true]
  reaction_available boolean [not null, default: true]
  free_interaction_available boolean [not null, default: true]
  max_movement integer [not null, default: 0]
  movement_used integer [not null, default: 0]
  persisted_at timestamptz [not null, default: `now()`]

  Indexes {
    encounter_session_id [name: "ix_turn_budgets_encounter_session_id"]
    combatant_id [name: "ix_turn_budgets_combatant_id"]
  }
}

Table content_packs {
  id varchar [pk, not null, note: "pack_id"]
  name varchar [not null]
  version varchar [not null]
  description text
  author varchar [not null]
  status content_lifecycle_status [not null, default: 'DRAFT']
  dependencies json [not null, default: "[]"]
  migration_notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (id, version) [name: "uq_content_packs_id_version", unique]
  }
}

Table action_definitions {
  id varchar [pk, not null, note: "UUID string"]
  action_id varchar [not null]
  name varchar [not null]
  description text [not null]
  family varchar [not null]
  action_type_cost varchar [not null]
  targeting_mode varchar [not null]
  range integer
  save_context json
  attack_context json
  resource_costs json [not null, default: "[]"]
  effect_intents json [not null, default: "[]"]
  tags json [not null, default: "[]"]
  status content_lifecycle_status [not null, default: 'DRAFT']
  content_version varchar [not null]
  pack_id varchar [not null]
  pack_version varchar [not null]
  author varchar [not null]
  last_modified_by varchar
  replacement_id varchar
  deprecation_notes text
  enabled boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    action_id [name: "ix_action_definitions_action_id"]
    (action_id, content_version) [name: "uq_action_definitions_id_version", unique]
    (pack_id, pack_version) [name: "ix_action_definitions_pack"]
  }
}

Table effect_definitions {
  id varchar [pk, not null, note: "UUID string"]
  effect_id varchar [not null]
  name varchar [not null]
  description text [not null]
  family varchar [not null]
  duration json [not null, default: "{}"]
  stacking json [not null, default: "{}"]
  modifiers json [not null, default: "[]"]
  grants_conditions json [not null, default: "[]"]
  periodic json [not null, default: "[]"]
  removal_triggers json [not null, default: "[]"]
  tags json [not null, default: "[]"]
  status content_lifecycle_status [not null, default: 'DRAFT']
  content_version varchar [not null]
  pack_id varchar [not null]
  pack_version varchar [not null]
  author varchar [not null]
  last_modified_by varchar
  replacement_id varchar
  deprecation_notes text
  enabled boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    effect_id [name: "ix_effect_definitions_effect_id"]
    (effect_id, content_version) [name: "uq_effect_definitions_id_version", unique]
    (pack_id, pack_version) [name: "ix_effect_definitions_pack"]
  }
}

Table ability_bindings {
  id varchar [pk, not null, note: "binding_id"]
  action_id varchar [not null]
  actor_template_id varchar
  actor_id varchar
  unlock_conditions json [not null, default: "[]"]
  override_payload json
  source_pack_id varchar [not null]
  source_pack_version varchar [not null]
  status content_lifecycle_status [not null, default: 'DRAFT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table item_definitions {
  id varchar [pk, not null, note: "UUID string"]
  item_id varchar [not null]
  name varchar [not null]
  description text [not null]
  status content_lifecycle_status [not null, default: 'DRAFT']
  content_version varchar [not null]
  pack_id varchar [not null]
  pack_version varchar [not null]
  author varchar [not null]
  last_modified_by varchar
  enabled boolean [not null, default: true]
  payload_json json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (item_id, content_version) [name: "uq_item_definitions_id_version", unique]
  }
}

Table monster_definitions {
  id varchar [pk, not null, note: "UUID string"]
  monster_id varchar [not null]
  name varchar [not null]
  description text [not null]
  status content_lifecycle_status [not null, default: 'DRAFT']
  content_version varchar [not null]
  pack_id varchar [not null]
  pack_version varchar [not null]
  author varchar [not null]
  last_modified_by varchar
  enabled boolean [not null, default: true]
  payload_json json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (monster_id, content_version) [name: "uq_monster_definitions_id_version", unique]
  }
}

Table spell_definitions {
  id varchar [pk, not null, note: "UUID string"]
  spell_id varchar [not null]
  name varchar [not null]
  description text [not null]
  status content_lifecycle_status [not null, default: 'DRAFT']
  content_version varchar [not null]
  pack_id varchar [not null]
  pack_version varchar [not null]
  author varchar [not null]
  last_modified_by varchar
  enabled boolean [not null, default: true]
  payload_json json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (spell_id, content_version) [name: "uq_spell_definitions_id_version", unique]
  }
}

Table feature_definitions {
  id varchar [pk, not null, note: "UUID string"]
  feature_id varchar [not null]
  name varchar [not null]
  description text [not null]
  status content_lifecycle_status [not null, default: 'DRAFT']
  content_version varchar [not null]
  pack_id varchar [not null]
  pack_version varchar [not null]
  author varchar [not null]
  last_modified_by varchar
  enabled boolean [not null, default: true]
  payload_json json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (feature_id, content_version) [name: "uq_feature_definitions_id_version", unique]
  }
}

Table feat_definitions {
  id varchar [pk, not null, note: "UUID string"]
  feat_id varchar [not null]
  name varchar [not null]
  description text [not null]
  status content_lifecycle_status [not null, default: 'DRAFT']
  content_version varchar [not null]
  pack_id varchar [not null]
  pack_version varchar [not null]
  author varchar [not null]
  last_modified_by varchar
  enabled boolean [not null, default: true]
  payload_json json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (feat_id, content_version) [name: "uq_feat_definitions_id_version", unique]
  }
}

Table species_definitions {
  id varchar [pk, not null, note: "UUID string"]
  species_id varchar [not null]
  name varchar [not null]
  description text [not null]
  status content_lifecycle_status [not null, default: 'DRAFT']
  content_version varchar [not null]
  pack_id varchar [not null]
  pack_version varchar [not null]
  author varchar [not null]
  last_modified_by varchar
  enabled boolean [not null, default: true]
  payload_json json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (species_id, content_version) [name: "uq_species_definitions_id_version", unique]
  }
}

Table class_definitions {
  id varchar [pk, not null, note: "UUID string"]
  class_id varchar [not null]
  name varchar [not null]
  description text [not null]
  status content_lifecycle_status [not null, default: 'DRAFT']
  content_version varchar [not null]
  pack_id varchar [not null]
  pack_version varchar [not null]
  author varchar [not null]
  last_modified_by varchar
  enabled boolean [not null, default: true]
  payload_json json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (class_id, content_version) [name: "uq_class_definitions_id_version", unique]
  }
}

Table background_definitions {
  id varchar [pk, not null, note: "UUID string"]
  background_id varchar [not null]
  name varchar [not null]
  description text [not null]
  status content_lifecycle_status [not null, default: 'DRAFT']
  content_version varchar [not null]
  pack_id varchar [not null]
  pack_version varchar [not null]
  author varchar [not null]
  last_modified_by varchar
  enabled boolean [not null, default: true]
  payload_json json [not null, default: "{}"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (background_id, content_version) [name: "uq_background_definitions_id_version", unique]
  }
}

Table regions {
  id varchar [pk, not null, note: "UUID string"]
  campaign_id varchar [not null]
  name varchar [not null]
  description text [not null]
  climate varchar
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    campaign_id [name: "ix_regions_campaign_id"]
    (campaign_id, name) [name: "uq_regions_campaign_name", unique]
  }
}

Table places {
  id varchar [pk, not null, note: "UUID string"]
  campaign_id varchar [not null]
  region_id varchar
  name varchar [not null]
  place_type place_type [not null]
  description text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    campaign_id [name: "ix_places_campaign_id"]
    region_id [name: "ix_places_region_id"]
    (campaign_id, name) [name: "uq_places_campaign_name", unique]
  }
}

Table factions {
  id varchar [pk, not null, note: "UUID string"]
  campaign_id varchar [not null]
  name varchar [not null]
  description text [not null]
  goals text
  beliefs text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    campaign_id [name: "ix_factions_campaign_id"]
    (campaign_id, name) [name: "uq_factions_campaign_name", unique]
  }
}

Table npcs {
  id varchar [pk, not null, note: "UUID string"]
  campaign_id varchar [not null]
  place_id varchar
  faction_id varchar
  name varchar [not null]
  role varchar [not null]
  actor_template_id varchar
  disposition npc_disposition [not null, default: 'NEUTRAL']
  notes text [not null, default: ""]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    campaign_id [name: "ix_npcs_campaign_id"]
    place_id [name: "ix_npcs_place_id"]
    faction_id [name: "ix_npcs_faction_id"]
  }
}

Table place_scenes {
  id varchar [pk, not null, note: "UUID string"]
  place_id varchar [not null]
  scene_id varchar [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (place_id, scene_id) [name: "uq_place_scenes_place_scene", unique]
  }
}

Table place_factions {
  id varchar [pk, not null, note: "UUID string"]
  place_id varchar [not null]
  faction_id varchar [not null]
  influence integer [not null, default: 0, note: "-100..100"]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (place_id, faction_id) [name: "uq_place_factions_place_faction", unique]
  }
}

Ref: campaigns.dm_id > users.id
Ref: campaign_members.campaign_id > campaigns.id
Ref: campaign_members.user_id > users.id

Ref: scenes.campaign_id > campaigns.id
Ref: encounter_sessions.campaign_id > campaigns.id
Ref: encounter_sessions.scene_id > scenes.id
Ref: combatant_states.encounter_session_id > encounter_sessions.id
Ref: turn_budgets.encounter_session_id > encounter_sessions.id
Ref: turn_budgets.combatant_id > combatant_states.id

Ref: campaigns.current_scene_id > scenes.id
Ref: campaigns.active_encounter_id > encounter_sessions.id

Ref: action_definitions.pack_id > content_packs.id
Ref: effect_definitions.pack_id > content_packs.id
Ref: ability_bindings.source_pack_id > content_packs.id
Ref: ability_bindings.action_id > action_definitions.action_id

Ref: item_definitions.pack_id > content_packs.id
Ref: monster_definitions.pack_id > content_packs.id
Ref: spell_definitions.pack_id > content_packs.id
Ref: feature_definitions.pack_id > content_packs.id
Ref: feat_definitions.pack_id > content_packs.id
Ref: species_definitions.pack_id > content_packs.id
Ref: class_definitions.pack_id > content_packs.id
Ref: background_definitions.pack_id > content_packs.id

Ref: regions.campaign_id > campaigns.id
Ref: places.campaign_id > campaigns.id
Ref: places.region_id > regions.id
Ref: factions.campaign_id > campaigns.id
Ref: npcs.campaign_id > campaigns.id
Ref: npcs.place_id > places.id
Ref: npcs.faction_id > factions.id

Ref: place_scenes.place_id > places.id
Ref: place_scenes.scene_id > scenes.id
Ref: place_factions.place_id > places.id
Ref: place_factions.faction_id > factions.id
